---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      index,
      prev: index > 0 ? projects[index - 1] : null,
      next: index < projects.length - 1 ? projects[index + 1] : null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
  index: number;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}
const { entry, index, prev, next } = Astro.props;
const project = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const no = String(index + 1).padStart(2, '0');
---

<BaseLayout title={project.title} description={`${project.title}: ${project.subtitle}`}>
  <div class="page-title">
    <a class="label back" href="/work/">&larr; All work</a>
    <span class="label proj__no">Sheet {no} · {project.category}</span>
    <h1>{project.title}</h1>
    <p class="lead">{project.subtitle}</p>
  </div>

  <section class="section detail">
    <figure>
      <Image src={project.image} alt={project.imageAlt} widths={[640, 1024, 1440]} sizes="(max-width: 1080px) 100vw, 1000px" loading="eager" fetchpriority="high" />
    </figure>

    <div class="detail__info">
      <p>{project.summary}</p>
      {hasBody && <div class="prose"><Content /></div>}
      <dl class="specs">
        <dt>Category</dt><dd>{project.category}</dd>
        <dt>Built with</dt>
        <dd><ul class="spec">{project.features.map((f) => <li>{f}</li>)}</ul></dd>
      </dl>
      {project.link && (
        <div class="btns">
          <a class="btn btn--primary" href={project.link.url} target="_blank" rel="noopener noreferrer">{project.link.label} &nearr;</a>
        </div>
      )}
    </div>
  </section>

  <nav class="pager" aria-label="More projects">
    {prev ? <a class="btn" href={`/work/${prev.id}/`}>&larr; {prev.data.title}</a> : <span></span>}
    {next && <a class="btn" href={`/work/${next.id}/`}>{next.data.title} &rarr;</a>}
  </nav>
</BaseLayout>

<style>
  .back { text-decoration: none; }
  .back:hover { color: var(--ink); }
  .detail figure { margin: 0; border: 1px solid var(--line); background: var(--tint); }
  .detail__info { display: grid; gap: 1.25rem; max-width: 68ch; }
  .prose { display: grid; gap: 1rem; }
  .specs { display: grid; grid-template-columns: max-content 1fr; gap: 0.6rem 1.5rem; margin: 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  .specs dt { font: 500 0.72rem var(--font-mono); letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); padding-top: 0.2rem; }
  .specs dd { margin: 0; }
  .specs .spec { margin: 0; }
  .pager { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: 1.25rem clamp(1.25rem, 3vw, 2.25rem); border-top: 1px solid var(--line); }
</style>

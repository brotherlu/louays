---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: index > 0 ? projects[index - 1] : null,
      next: index < projects.length - 1 ? projects[index + 1] : null,
    },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
---

<BaseLayout
  title={project.title}
  description={`${project.title} — ${project.subtitle}`}
  theme="work"
>
  <section class="page-banner">
    <div class="container">
      <a class="back-link" href="/work/">&larr; All Projects</a>
      <h1>{project.title}</h1>
      <p class="page-banner__subtitle">{project.subtitle}</p>
    </div>
  </section>

  <section class="page-body">
    <div class="container detail-wrap">
      <figure class="detail-media">
        <Image
          src={project.image}
          alt={project.imageAlt}
          widths={[640, 1024, 1440]}
          sizes="(max-width: 960px) 100vw, 960px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="card detail-info">
        <span class="card__tag">{project.category}</span>
        <h2>Features &amp; Highlights</h2>
        <ul class="feature-list">
          {project.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>

        {project.link && (
          <div class="detail-actions">
            <a
              class="btn btn--light"
              href={project.link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.link.label} &nearr;
            </a>
          </div>
        )}
      </div>

      <nav class="project-pager" aria-label="More projects">
        {prev ? (
          <a class="btn btn--ghost" href={`/work/${prev.slug}/`}>&larr; {prev.title}</a>
        ) : (
          <span></span>
        )}
        {next && (
          <a class="btn btn--ghost" href={`/work/${next.slug}/`}>{next.title} &rarr;</a>
        )}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.85;
  }

  .back-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .detail-wrap {
    max-width: 960px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail-media {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }

  .detail-media img {
    width: 100%;
    height: auto;
  }

  .detail-info h2 {
    margin-bottom: 1rem;
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .feature-list li {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.22);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .detail-actions {
    margin-top: 1.75rem;
  }

  .project-pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
  }
</style>

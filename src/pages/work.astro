---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const groups = [
  { title: 'Aerospace & modelling', kind: 'aerospace' },
  { title: 'Software & web', kind: 'software' },
] as const;
---

<BaseLayout title="Work" description="Selected engineering, web development and aerospace projects by Louay Cheikh.">
  <div class="page-title">
    <span class="label">{projects.length} sheets</span>
    <h1>Work</h1>
    <p class="lead">I enjoy having my hand in many diverse projects. It's fun to create and to build, be it software or physibles.</p>
  </div>

  {groups.map((g) => (
    <section class="section">
      <h2>{g.title}</h2>
      <div class="grid">
        {projects.map((p, i) => p.data.kind === g.kind && <ProjectCard project={p} index={i} />)}
      </div>
    </section>
  ))}
</BaseLayout>

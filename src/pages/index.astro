---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';
import { site, titleBlock } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const services = await Promise.all(
  (await getCollection('services'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (s) => ({ title: s.data.title, Content: (await render(s)).Content })),
);
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero__copy">
      <span class="label">{site.location} · engineer · developer</span>
      <h1>I build aircraft and <em>software.</em></h1>
      <p class="lead">
        Engineer who writes production code. From a fully autonomous tandem-wing UAV to
        Laravel and Angular platforms for real clients.
      </p>
      <div class="btns">
        <a class="btn btn--primary" href="#work">See selected work</a>
        <a class="btn" href="/contact/">Get in touch</a>
      </div>
    </div>

    <div class="hero__drawing" aria-hidden="true">
      <svg viewBox="0 0 420 260" role="img">
        <rect class="stroke" x="195" y="40" width="30" height="180" rx="15" />
        <path class="stroke" d="M195 70 L40 92 L40 112 L195 108 Z" />
        <path class="stroke" d="M225 70 L380 92 L380 112 L225 108 Z" />
        <path class="stroke" d="M195 168 L90 182 L90 198 L195 192 Z" />
        <path class="stroke" d="M225 168 L330 182 L330 198 L225 192 Z" />
        <line class="dim" x1="40" y1="236" x2="380" y2="236" />
        <line class="dim" x1="40" y1="228" x2="40" y2="244" />
        <line class="dim" x1="380" y1="228" x2="380" y2="244" />
        <rect x="165" y="226" width="90" height="18" fill="var(--tint)" />
        <text class="dtxt" x="210" y="239" text-anchor="middle">SPAN</text>
        <text class="dtxt" x="232" y="48">SELIG 1223</text>
      </svg>
    </div>
  </section>

  <div class="titleblock">
    {titleBlock.map((t) => <div><span>{t.label}</span><b>{t.value}</b></div>)}
    <div><span>Status</span><b>{site.status}</b></div>
  </div>

  <section class="section" id="work">
    <div class="section-head">
      <span class="label">{projects.length} sheets · scale 1:1</span>
      <h2>Selected work</h2>
    </div>
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <section class="section" id="services">
    <div class="section-head">
      <span class="label">Services</span>
      <h2>How I can help</h2>
    </div>
    <div class="strip">
      {services.map((s) => <div><h3>{s.title}</h3><s.Content /></div>)}
    </div>
    <div class="btns"><a class="btn btn--primary" href="/contact/">Start a conversation</a></div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
  .hero__copy {
    padding: clamp(1.5rem, 4vw, 3.25rem);
    display: grid;
    gap: 1.25rem;
    align-content: center;
  }
  .hero h1 { font-size: clamp(2.4rem, 6.4vw, 4.6rem); line-height: 0.98; }
  .hero h1 em { font-style: normal; color: var(--signal); }
  .hero__drawing {
    border-left: 1px solid var(--line);
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--tint);
    display: grid;
    place-items: center;
    padding: 1.5rem;
    min-height: 280px;
  }
  .hero__drawing svg { width: 100%; max-width: 420px; height: auto; }
  .hero__drawing :global(.stroke) { stroke: var(--ink); fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; }
  .hero__drawing :global(.dim) { stroke: var(--signal); fill: none; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .hero__drawing :global(.dtxt) { font: 500 11px var(--font-mono); fill: var(--signal); }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .hero__drawing { border-left: 0; border-top: 1px solid var(--line); min-height: 220px; }
  }
</style>

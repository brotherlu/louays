---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Get in touch with Louay Cheikh.">
  <div class="page-title">
    <span class="label">{site.status}</span>
    <h1>Contact</h1>
    <p class="lead">Got a project in mind? Let's discuss it.</p>
  </div>

  <section class="section">
    <div class="strip">
      <div>
        <span class="label">Email</span>
        <h3><a href={`mailto:${site.email}`}>{site.email}</a></h3>
      </div>
      {site.links.map((l) => (
        <div>
          <span class="label">{l.label}</span>
          <h3><a href={l.url} target="_blank" rel="noopener noreferrer">{l.handle}</a></h3>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

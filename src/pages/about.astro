---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, bio, skillGroups } from '../data/site';
---

<BaseLayout title="About" description="About Louay Cheikh: developer, designer and engineer based in Montréal.">
  <div class="page-title">
    <span class="label">{site.location}</span>
    <h1>About</h1>
  </div>

  <section class="section about">
    <div class="about__bio">
      {bio.map((p) => <p>{p}</p>)}
      {site.cv && <div class="btns"><a class="btn" href={site.cv.url}>{site.cv.label}</a></div>}
    </div>

    <div class="about__skills">
      <h2>Toolkit</h2>
      {skillGroups.map((g) => (
        <div class="skill-group">
          <span class="label">{g.group}</span>
          <ul class="spec">{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about { grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 2.5rem; align-items: start; }
  .about__bio { display: grid; gap: 1rem; max-width: 62ch; font-size: 1.1rem; }
  .about__skills { display: grid; gap: 1.1rem; }
  .skill-group { display: grid; gap: 0.5rem; }
</style>

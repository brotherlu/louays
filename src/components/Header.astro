---
import { nav } from '../data/site';
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && (pathname === href.replace(/\/+$/, '') || pathname.startsWith(href.replace(/\/+$/, '') + '/'));
---

<header class="site-header">
  <a class="mark" href="/" aria-label="Louay Cheikh, home">louay<b>.</b>s</a>
  <nav class="site-nav" aria-label="Primary">
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
